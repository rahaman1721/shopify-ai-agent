# Google Gemini (FREE — get from https://aistudio.google.com)
GEMINI_API_KEY=AIza...

# Shopify Storefront API (public access token — safe to use on backend)
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shp_public_...

# Shopify Admin API (PRIVATE — only on server, never expose to frontend)
SHOPIFY_ADMIN_API_KEY=shpat_...

# CORS — your Vercel/frontend origin
ALLOWED_ORIGINS=https://your-store.myshopify.com,http://localhost:5173

# Rate limiting
MAX_REQUESTS_PER_MINUTE=20
